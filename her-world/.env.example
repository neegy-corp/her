HELIUS_API_KEY=
# Dedicated random bearer token of at least 32 characters, shared with the studio/tool.
HER_WALLET_READ_TOKEN=

# Private operator panel. Generate random credentials locally with
# node --experimental-strip-types scripts/operator-credentials.mjs
# Keep all values server-only, never NEXT_PUBLIC_*. Disabled until approved.
HER_OPERATOR_ENABLED=false
HER_OPERATOR_PATH_KEY=
HER_OPERATOR_PASSWORD_HASH=
HER_OPERATOR_SESSION_SECRET=
# Dedicated backend signer: base58 64-byte secret key or JSON 64-byte array.
# Production server-only sensitive variable. Never commit a real key.
HER_WALLET_PRIVATE_KEY=
# Separate execution gate. Each order requires authenticated operator review.
HER_OPERATOR_TRADING_ENABLED=false
JUPITER_API_KEY=
HER_POSITION_UPDATE_MINUTES=10

# Character launchpad. All paid actions default off; no creator billing yet.
HER_LAUNCHPAD_ENABLED=false
HER_LAUNCHPAD_GENERATION_ENABLED=false
HER_LAUNCHPAD_FACES_ENABLED=false
HER_LAUNCHPAD_VIDEOS_ENABLED=false
HER_LAUNCHPAD_COINS_ENABLED=false
