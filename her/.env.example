# Server only. Never prefix these with NEXT_PUBLIC_ or VITE_.
TAVUS_API_KEY=
# Use a licensed female Tavus face or a consenting custom replica.
TAVUS_FACE_ID=
TAVUS_PAL_ID=
# Optional fixed Tavus voice; cannot be combined with external voice settings.
TAVUS_VOICE_ID=
# Local setup only: fetchable HTTPS image, or use PAL Maker upload instead.
HER_TRAIN_IMAGE_URL=
HER_TRAIN_VOICE_NAME=anna
# Optional external voice alternative (cartesia or elevenlabs).
HER_TTS_ENGINE=
HER_EXTERNAL_VOICE_ID=
HER_TTS_MODEL=
HER_TTS_API_KEY=
# HTTPS endpoint serving authenticated, normalized pump.fun chat (see README).
PUMP_CHAT_FEED_URL=
PUMP_CHAT_FEED_TOKEN=
# Separate relay process: use a random secret of at least 32 characters.
HER_RELAY_TOKEN=
HER_RELAY_MINT=
